# Copy this to .env and fill in production values
FLASK_ENV=production
SECRET_KEY=generate-a-random-64-character-string
JWT_SECRET_KEY=generate-another-random-64-character-string
DATABASE_URL=postgresql://user:password@host:5432/playwright_dashboard
MAX_PARALLEL_WORKERS=4
DEFAULT_TIMEOUT=30000
DEFAULT_RETRIES=1
HEADLESS=true
CORS_ORIGINS=https://your-frontend-domain.vercel.app
